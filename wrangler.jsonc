{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webooks",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": {
    "enabled": true
  },

  // ═══════════════════════════════════════════════════════════════════════
  // 只有**必须由部署者填**的值才写在这里。
  //
  // 其余参数（挂载前缀、单目录上限、缓存 TTL、上传体积、写配额、深度策略）
  // 全部走 src/config.ts 里的默认值 —— 它们的值已调整过，每一项都有
  // 实测或官方文档支撑，理由都写在那个文件的注释里。
  //
  // 以前这里重复了 6 个值，与代码默认值完全一致，纯属冗余，而且有
  // 漂移风险：改了一处忘了另一处，两边就不一致了。更糟的是
  // MAX_UPLOAD_BYTES —— 代码里已经 clamp 到 Cloudflare 的请求体上限，
  // 配置文件里写一个更大的值**不会生效**，只会让人误以为可以放宽。
  //
  // 想调整某个参数？改 src/config.ts 里对应的常量，或用
  // `wrangler deploy --var KEY=VALUE` 临时覆盖（不要写回本文件）。
  // ═══════════════════════════════════════════════════════════════════════
  "vars": {
    // R2 桶的公开自定义域 —— **唯一必填项**。
    //
    // GET 会 302 跳到这里，从而下载的字节完全不经过 Worker（不占 CPU/内存、
    // 不受请求体上限约束）。换域名部署时改这一行即可。
    //
    // ⚠️ 不要用 r2.dev —— Cloudflare 官方明示它不适用于生产。
    //   症状：目录能列、一点下载就 530。
    // ⚠️ 必须是 https，且不带尾部斜杠。
    "R2_PUBLIC_BASE": "https://books.cszxorx.dpdns.org"
  },

  // ── 资源绑定 ────────────────────────────────────────────────────────
  // bucket_name / database_name 用的是**语义化名字**而非随机 ID：
  // wrangler 的「自动资源创建」（2025-10-24 上线，需 wrangler ≥ 4.45）
  // 会按名字查找，找不到就创建。好处是 fork 后一条命令就能部署，
  // 而配置文件里不含任何账号相关信息。
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "webooks-bucket"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webooks-db",
      // database_id 是 wrangler 自动创建后写回的。⚠️ 它是账号相关的，
      //   换账号部署时 wrangler 会覆盖成新值（见 CHANGELOG）。
      "database_id": "b0edfbd4-f6f1-468f-abb8-481dda7b1721",
      "migrations_dir": "migrations"
    }
  ],

  // ═══════════════════════════════════════════════════════════════════════
  // 静态资源 —— **唯一能真正省下 100,000 次/天请求配额的手段**
  //
  // 先把结论说清楚，因为这里有一个反直觉的定价事实：
  //
  //   · Cache API（caches.default，本项目一直在用）
  //     官方原文：「every request still executes your Worker on the way in」
  //     —— 它只省**上游**（D1/R2），一次请求都不省。
  //
  //   · Workers Caching（cache.enabled）
  //     看着像是正解，实则**正好相反**。官方定价页脚注：命中缓存仍按标准
  //     费率计费（「Cache hits count as requests but do not consume CPU time」），
  //     并且开启后连平时免费的静态资源请求也一并变成计费。
  //     我们的瓶颈是**请求数**不是 CPU，所以开启它是净亏损。**故不开。**
  //
  //   · 静态资源请求
  //     官方原文：「Requests to static assets are free and unlimited.」
  //     —— 只有这一类请求不计入配额，而且**完全不经过 Worker 代码**。
  //
  // 所以省请求数只有三条路：① 把响应变成静态资源；② 让客户端少发请求；
  // ③ 让请求不经过本站（302 跳 R2）。这里走第 ① 条。
  //
  // ── public/ 里放了什么，为什么 ──
  //   · favicon.ico、robots.txt —— 各自堵掉一类**每次访问都发生**的浪费
  //   · 404.html —— 让「不存在的路径」不再花 Worker 请求（见下）
  // HTML 页面**故意不放进来**：它们是动态渲染的（首页要插 DAV_MOUNT 与
  // R2_PUBLIC_BASE，上传页要插 Turnstile 公钥），一旦落成静态文件，
  // 部署时的 --var 覆盖就再也反映不到页面上 —— 那是一种静默失效。
  //
  // ═══ not_found_handling: "404-page" + run_worker_first：一次被推翻的决定 ═══
  //
  // 这里最初配的是 `"none"`，并把「绝不改成 404-page」写进了注释。**这个
  // 决定后来被推翻了**，因为它把最贵的一类请求留在了计费侧：
  //
  //   "none" 下，每一个**不存在的路径**（/wp-login.php、/.env、
  //   /administrator、/sitemap.xml… 扫描器与爬虫的长尾）都要花
  //   1 次 Worker 请求换回文本 404。而这类请求的**数量不受本站控制** ——
  //   这正是 10 万/天被打满时的形态：请求量可以毫无预兆地翻几倍。
  //
  //   "404-page" 把这类请求变成静态资源应答（free and unlimited，
  //   完全不跑 Worker）。代价是必须用 run_worker_first 把**属于 Worker
  //   的路径逐个列出来** —— 不在列表里又没有对应资源的路径，一律吃静态
  //   404 页。
  //
  // ── 为什么单独用 404-page 会毁掉整站（实测，不是推理）──
  //   "404-page" + 没有 run_worker_first 时，**浏览器访问的每一个 Worker
  //   路由都会被静态 404 页吃掉**。触发条件只有一个请求头
  //   `Sec-Fetch-Mode: navigate`（真实浏览器每次顶层导航都会带），
  //   而 curl 不带 —— 于是 curl 冒烟测试全绿，真人打开 /upload、/requests、
  //   /admin、/dav/ 全是 404。workerd 日志原话：
  //     `Sec-Fetch-Mode: navigate` header present - using `not_found_handling` behavior
  //
  // ── 所以这个列表就是「哪些路径归 Worker」的唯一清单 ──
  // 规则语义（实测）：匹配请求路径；`/x/*` 匹配 `/x/` 与 `/x/任意`，
  // **不匹配 `/x` 本身**；大小写敏感且字面匹配（`/HEALTH`、`/health/` 会漏）；
  // 它**优先于**命中的静态资源。上限 100 条。
  //
  // ⚠️ 漏一条 = 那个路由对真人静默 404，而且**测试套件抓不到**
  //    （SELF.fetch 完全不经过资源路由层）。因此有三道防线：
  //      ① 这个列表由 test/static-assets.test.ts 对着 src/index.ts 的
  //         路由字面量**逐条比对** —— 加了新路由忘了同步，测试立刻红；
  //      ② scripts/verify-deploy.mjs 带 `Sec-Fetch-Mode: navigate` 探线上，
  //         真人导航吃静态 404 时部署验证会失败；
  //      ③ 未知路径由 `__routecheck_*` 探针确认仍是静态 404（省下请求）。
  //
  // ⚠️ DAV_MOUNT 是**部署期可覆盖**的（`--var DAV_MOUNT=...`，空串 = 挂在
  //    站点根）。列表里写死了 `/dav`，所以改了它就必须同步改列表，
  //    否则整棵书柜树会被静态 404 吃掉。测试里有一条断言钉着
  //    「wrangler.jsonc 不许出现 vars.DAV_MOUNT」，正是为了让这层耦合显式。
  // ═══════════════════════════════════════════════════════════════════════
  "assets": {
    "directory": "./public",
    // binding 没有用到（Worker 里不会 env.ASSETS.fetch），
    // 但显式写出来让 wrangler 的 dry-run 输出能看清它被绑上了。
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // 归 Worker 的路径。**改路由时必须同步这里**（见上面的三道防线）。
    // 每条都写「带斜杠」与「不带斜杠」两种形态：`/x/*` 不匹配 `/x`，
    // 而 `/requests/` 既不对应任何静态资源，也不会被自动重定向。
    "run_worker_first": [
      "/",
      "/health",
      "/api/*",
      "/dav",
      "/dav/*",
      "/requests",
      "/requests/",
      "/upload",
      "/upload/",
      "/admin",
      "/admin/"
    ]
  }

  // 令牌类全部用 secret，绝不进仓库：
  //   ADMIN_TOKEN           保护 /api/admin/*     必填（未配置则全部 404）
  //   WRITE_TOKEN           保护删除/覆盖        强烈建议（未配置则不保护）
  //   TURNSTILE_SITE_KEY    上传页的验证码公钥
  //   TURNSTILE_SECRET      服务端校验用
  //   R2_ACCESS_KEY_ID      预签名直传
  //   R2_SECRET_ACCESS_KEY  预签名直传
  //
  // 全部用 `npx wrangler secret put <名字>` 设置，详见 docs/DEPLOY.md。
}